{
  "name": "@typort/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "bin": {
    "typort": "./dist/bin/typort.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/bin/typort.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/typort.bundle.cjs --external:bufferutil --external:utf-8-validate --legal-comments=none && chmod +x dist/typort.bundle.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node ./dist/bin/typort.js"
  },
  "dependencies": {
    "@typort/file-session": "workspace:*",
    "@typort/protocol": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
