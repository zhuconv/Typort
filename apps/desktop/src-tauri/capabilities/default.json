{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window and editor session windows.",
  "windows": ["main", "session-*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:event:default",
    "opener:default",
    "opener:allow-open-url",
    "mcp-bridge:default"
  ]
}
