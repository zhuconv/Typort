{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  // src/demo/samples holds raw, ?raw-imported sample files (.ts, .py, ...) —
  // demo data, not program source, so tsc must not try to compile them.
  "exclude": ["node_modules", "dist", "src-tauri", "src/demo/samples"]
}
